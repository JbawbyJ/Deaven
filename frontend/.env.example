# Copy to frontend/.env.local if the API is not on localhost:8000.
# No secrets belong in this file.
VITE_API_URL=http://localhost:8000

# Map tiles. Defaults are the public OpenStreetMap tile server.
# https://operations.osmfoundation.org/policies/tiles/
# The app loads only the tiles in the current view. It does not prefetch or bulk-download.
# Swap these before a public launch. OSM's tile servers are not a CDN, and there is no API key.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
