# Copy to backend/.env if you want to override defaults.
# Local MVP runs with these values as-is — no production keys required.

PIPELINE_MODE=local
SCOUT_BACKEND=local
STORE_BACKEND=local
SEED_DEMO_DEALS=true
# SCOUT_SCHEDULER=false
# ALERT_WEBHOOK_URL=
# DEAVEN_DATA_DIR=backend/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — only needed for STORE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=

# Optional public NHTSA vPIC VIN decode. Off by default; no API key.
# VIN_VPIC_ENABLED=false

# Optional — live agents / scrapers (PIPELINE_MODE=full or SCOUT_BACKEND=live)
ANTHROPIC_API_KEY=
# eBay Browse API client-credentials. Names only; leave the values empty.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Deprecated. The Finding API is retired. Ingestion does not read EBAY_APP_ID.
# The legacy scout module backend/agents/scrapers/ebay.py still would, if set.
# EBAY_APP_ID=
APIFY_TOKEN=
FIRECRAWL_API_KEY=
CARFAX_API_KEY=
NHTSA_API_KEY=
AUTOCHECK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
